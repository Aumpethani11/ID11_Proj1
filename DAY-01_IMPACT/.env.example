# ============================================================
# Frontend (React) environment variables
# Copy this file to .env in DAY-01_IMPACT/ and fill in values.
# NOTE: Create React App only exposes vars prefixed with REACT_APP_.
# ============================================================

# Groq API keys (AI chat + translation)
REACT_APP_GROQ_API_KEY=your_groq_api_key
REACT_APP_GROQ_TRANSLATION_KEY_1=your_groq_translation_key_1
REACT_APP_GROQ_TRANSLATION_KEY_2=your_groq_translation_key_2

# ----- Deployment URLs -----
# Backend (Socket.IO server) the frontend connects to.
# Local:      http://localhost:5000
# Production: https://your-backend-domain.com
REACT_APP_SOCKET_URL=http://localhost:5000

# Public URL where this frontend is hosted.
# Local:      http://localhost:3000
# Production: https://your-frontend-domain.com
REACT_APP_FRONTEND_URL=http://localhost:3000
