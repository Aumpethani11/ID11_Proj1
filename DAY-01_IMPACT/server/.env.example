# ============================================================
# Backend (Socket.IO server) environment variables
# Copy this file to .env in DAY-01_IMPACT/server/ and fill in values.
# ============================================================

# Port the server listens on.
# Many hosts (Render, Railway, Heroku) inject PORT automatically.
PORT=5000

# Allowed frontend origin(s) for CORS / Socket.IO.
# Accepts "*", a single URL, or a comma-separated list of URLs.
# Local:      http://localhost:3000
# Production: https://your-frontend-domain.com
# Multiple:   https://your-frontend-domain.com,http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000
